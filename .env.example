# ── Required ──────────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# ── AI features — /npc speak and narrator voice (set ONE of these three) ─────
# Option A: Anthropic (paid, fast) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B: OpenAI-compatible endpoint (Groq free tier, LM Studio, LocalAI…)
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.1-8b-instant
#   LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1      OPENAI_MODEL=<loaded model>
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Option C: Ollama (free, fully local — https://ollama.com)
#   Run: ollama pull llama3
OLLAMA_MODEL=
OLLAMA_URL=

# ── Narrator voice (AI combat narration) ──────────────────────────────────────
# 0 = rich templates only (default, no API key needed)
# 1 = AI generates dynamic narration lines via Anthropic / OpenAI / Ollama key above
NARRATOR_AI=0

# ── Database mode ─────────────────────────────────────────────────────────────
# 0 = standalone  →  creates campaign.db next to run.py  (default)
# 1 = shared      →  reads ../dndcampaign/dndcampaign.db (requires main app)
USE_SHARED_DB=0

# Optional: override the standalone DB path
# BOT_DB_PATH=/absolute/path/to/campaign.db
